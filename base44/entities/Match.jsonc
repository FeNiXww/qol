{
  "name": "Match",
  "type": "object",
  "properties": {
    "user_a_id": {
      "type": "string"
    },
    "user_b_id": {
      "type": "string"
    },
    "user_a_profile_id": {
      "type": "string"
    },
    "user_b_profile_id": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "age_band": {
      "type": "string",
      "enum": [
        "minor",
        "adult"
      ]
    },
    "user_a_cleared_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_b_cleared_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_group": {
      "type": "boolean",
      "default": false,
      "description": "True when this Match represents a group chat instead of a 1:1 connection"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids of all group participants (used instead of user_a/b for group matches)"
    },
    "owner_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User ids who can edit the group, add members, and kick others"
    },
    "cleared_at_map": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-participant ISO timestamps of when each one cleared the group chat"
    }
  },
  "required": [
    "user_a_id",
    "user_b_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_a_id": "{{user.id}}"
        },
        {
          "data.user_b_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}