{
  "name": "DictionaryWord",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this dictionary word"
    },
    "text_he": {
      "type": "string"
    },
    "text_ar": {
      "type": "string"
    },
    "translit_he": {
      "type": "string",
      "description": "Pronunciation of the Hebrew word written in Arabic letters"
    },
    "translit_ar": {
      "type": "string",
      "description": "Pronunciation of the Arabic word written in Hebrew letters"
    },
    "known": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "text_he",
    "text_ar"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.known": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}