{
  "name": "Swipe",
  "type": "object",
  "properties": {
    "swiper_id": {
      "type": "string",
      "description": "User who swiped"
    },
    "target_id": {
      "type": "string",
      "description": "User who was swiped on"
    },
    "direction": {
      "type": "string",
      "enum": [
        "like",
        "pass"
      ]
    }
  },
  "required": [
    "swiper_id",
    "target_id",
    "direction"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.swiper_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.swiper_id": "{{user.id}}"
        },
        {
          "data.target_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.swiper_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.swiper_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}