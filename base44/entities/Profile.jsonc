{
  "name": "Profile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "References the auth user"
    },
    "nationality": {
      "type": "string",
      "enum": [
        "israeli",
        "palestinian"
      ]
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "age_band": {
      "type": "string",
      "enum": [
        "minor",
        "adult"
      ]
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hobbies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "onboarding_step": {
      "type": "string",
      "enum": [
        "nationality",
        "about",
        "hobbies",
        "profile",
        "complete"
      ],
      "default": "nationality"
    },
    "display_name": {
      "type": "string"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "Heartbeat timestamp for online presence"
    }
  },
  "required": [
    "nationality"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}