{
  "name": "GroupInvite",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "The group's Match record id"
    },
    "group_id": {
      "type": "string",
      "description": "Optional Group metadata row id"
    },
    "inviter_id": {
      "type": "string",
      "description": "Owner who sent the invitation"
    },
    "invitee_id": {
      "type": "string",
      "description": "User being invited"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "match_id",
    "inviter_id",
    "invitee_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.inviter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.inviter_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.inviter_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.inviter_id": "{{user.id}}"
        },
        {
          "data.invitee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}